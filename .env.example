NODE_ENV=development
PORT=3000

# Cơ sở dữ liệu MySQL 8.0 (Aiven hoặc cục bộ)
DB_HOST=localhost
DB_PORT=3306
DB_USER=doan_user
DB_PASSWORD=thay-bang-mat-khau-cua-ban
DB_NAME=doan_db
# true khi dùng Aiven (bắt buộc SSL). Để trống: tự bật nếu DB_HOST khác localhost.
DB_SSL=false
# (Tùy chọn) Chứng chỉ CA của Aiven dạng PEM, thay ký tự xuống dòng bằng \n
DB_SSL_CA=

DB_POOL_LIMIT=5

# Khóa ký JWT: chuỗi ngẫu nhiên tối thiểu 32 ký tự. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=thay-bang-chuoi-ngau-nhien-toi-thieu-32-ky-tu
JWT_EXPIRES_IN=1h

# Băm mật khẩu và chống dò mật khẩu
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Xếp hạng có xét độ tin cậy: weighted_score = (v*R + m*C) / (v + m)
# m = số lượt chấm tối thiểu để được tin cậy đầy đủ (mặc định 25).
# C dự phòng khi hệ thống chưa có lượt chấm nào (mặc định 3.0); bình thường C = trung bình toàn hệ thống.
RANKING_MIN_VOTES=
RANKING_PRIOR_MEAN=3.0

DEMO_PASSWORD=dat-mat-khau-demo-rieng
